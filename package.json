{
  "name": "@0xhoneyjar/freeside-cli",
  "version": "0.1.0-alpha.0",
  "description": "Sovereign CLI for navigating Freeside zones, worlds, and deployments. The CLI is sovereign · the construct is the lens · they compose.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "freeside": "./src/bin/freeside.ts"
  },
  "scripts": {
    "dev": "bun run src/bin/freeside.ts",
    "build": "bun build src/bin/freeside.ts --target=node --outfile=dist/freeside.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "incur": "^0.4.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "freeside",
    "cli",
    "hexagonal",
    "0xhoneyjar",
    "agent-cli",
    "incur"
  ]
}
